import { VideoTimelineView } from "video_timeline.slint";

export component MainEditorWindow inherits Window {
    title: "Camerashot Editor";
    width: 1200px;
    height: 800px;
    background: #18181c;

    // --- Existing properties ---
    in property <bool> is-video-mode: false;

    // --- Phase 3 new properties ---
    in property <image> canvas-image;
    in property <length> image-width: 0px;
    in property <length> image-height: 0px;
    in-out property <float> zoom-level: 1.0;
    in property <string> status-text: "";
    in property <bool> busy: false;
    in property <string> ocr-text: "";
    in property <bool> ocr-panel-visible: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    // --- Existing callbacks ---
    callback copy-to-clipboard();
    callback save-image();
    callback auto-redact();
    callback perform-ocr();

    // --- Phase 3 new callbacks ---
    callback undo();
    callback redo();
    callback copy-ocr-text();
    callback zoom-in();
    callback zoom-out();
    callback zoom-fit();
    callback zoom-actual();

    // --- Phase 4 video mode properties ---
    in-out property <float> current-time: 0;
    in property <float> total-duration: 0;
    in property <bool> is-playing: false;
    in property <bool> is-recording: false;
    in property <int> cut-count: 0;
    in property <int> zoom-count: 0;
    in property <int> censor-count: 0;

    // --- Phase 4 video mode callbacks ---
    callback toggle-record();
    callback toggle-playback();
    callback seek(float);
    callback add-cut();
    callback add-zoom();
    callback add-censor();
    callback exit-video();
    callback video-clicked(float, float);

    // Keyboard shortcut handler
    FocusScope {
        key-pressed(event) => {
            // ⌘Z / Ctrl+Z → Undo
            if (event.text == "z" && event.modifiers.meta && !event.modifiers.shift) {
                root.undo();
                return accept;
            }
            // ⇧⌘Z / Ctrl+Shift+Z → Redo
            if (event.text == "Z" && event.modifiers.meta && event.modifiers.shift) {
                root.redo();
                return accept;
            }
            // ⌘C / Ctrl+C → Copy
            if (event.text == "c" && event.modifiers.meta) {
                root.copy-to-clipboard();
                return accept;
            }
            // ⌘S / Ctrl+S → Save
            if (event.text == "s" && event.modifiers.meta) {
                root.save-image();
                return accept;
            }
            // ⌘= / Ctrl+= → Zoom In
            if (event.text == "=" && event.modifiers.meta) {
                root.zoom-in();
                return accept;
            }
            // ⌘- / Ctrl+- → Zoom Out
            if (event.text == "-" && event.modifiers.meta) {
                root.zoom-out();
                return accept;
            }
            // ⌘0 / Ctrl+0 → Fit
            if (event.text == "0" && event.modifiers.meta) {
                root.zoom-fit();
                return accept;
            }
            // ⌘1 / Ctrl+1 → 100%
            if (event.text == "1" && event.modifiers.meta) {
                root.zoom-actual();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // ═══════════ Top Toolbar ═══════════
            Rectangle {
                height: 44px;
                background: #22222a;
                border-width: 1px;
                border-color: #32323e;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        text: "Camerashot";
                        font-size: 15px;
                        font-weight: 800;
                        color: #ffffff;
                        vertical-alignment: center;
                    }

                    Rectangle { /* Spacer */ }

                    // --- Zoom controls ---
                    Rectangle {
                        width: 32px;
                        height: 28px;
                        background: root.busy ? #333340 : #4a4a5a;
                        border-radius: 4px;
                        Text {
                            text: "−";
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 700;
                        }
                        TouchArea {
                            enabled: !root.busy;
                            clicked => { root.zoom-out(); }
                        }
                    }

                    Text {
                        text: @tr("{}%", Math.round(root.zoom-level * 100));
                        color: #aaaacc;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: 46px;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        width: 32px;
                        height: 28px;
                        background: root.busy ? #333340 : #4a4a5a;
                        border-radius: 4px;
                        Text {
                            text: "+";
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 700;
                        }
                        TouchArea {
                            enabled: !root.busy;
                            clicked => { root.zoom-in(); }
                        }
                    }

                    Rectangle {
                        width: 40px;
                        height: 28px;
                        background: root.busy ? #333340 : #4a4a5a;
                        border-radius: 4px;
                        Text {
                            text: "Fit";
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            enabled: !root.busy;
                            clicked => { root.zoom-fit(); }
                        }
                    }

                    Rectangle {
                        width: 48px;
                        height: 28px;
                        background: root.busy ? #333340 : #4a4a5a;
                        border-radius: 4px;
                        Text {
                            text: "100%";
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            enabled: !root.busy;
                            clicked => { root.zoom-actual(); }
                        }
                    }

                    // --- Divider ---
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: #3a3a48;
                    }

                    // --- Undo / Redo ---
                    Rectangle {
                        width: 56px;
                        height: 28px;
                        background: root.can-undo && !root.busy ? #4a4a5a : #333340;
                        border-radius: 4px;
                        Text {
                            text: "Undo";
                            color: root.can-undo && !root.busy ? #ffffff : #666680;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            enabled: root.can-undo && !root.busy;
                            clicked => { root.undo(); }
                        }
                    }

                    Rectangle {
                        width: 56px;
                        height: 28px;
                        background: root.can-redo && !root.busy ? #4a4a5a : #333340;
                        border-radius: 4px;
                        Text {
                            text: "Redo";
                            color: root.can-redo && !root.busy ? #ffffff : #666680;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            enabled: root.can-redo && !root.busy;
                            clicked => { root.redo(); }
                        }
                    }

                    // --- Divider ---
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: #3a3a48;
                    }

                    // --- Image-mode-only actions ---
                    if !root.is-video-mode && !root.is-recording: Rectangle {
                        width: 110px;
                        height: 28px;
                        background: root.busy ? #993a35 : #ff5f56;
                        border-radius: 4px;
                        Text {
                            text: root.busy ? "Working…" : "Auto-Redact";
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 600;
                        }
                        TouchArea {
                            enabled: !root.busy;
                            clicked => { root.auto-redact(); }
                        }
                    }

                    if !root.is-video-mode && !root.is-recording: Rectangle {
                        width: 70px;
                        height: 28px;
                        background: root.busy ? #333340 : #4a4a5a;
                        border-radius: 4px;
                        Text {
                            text: root.busy ? "…" : "OCR";
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            enabled: !root.busy;
                            clicked => { root.perform-ocr(); }
                        }
                    }

                    // --- Video-mode edit buttons ---
                    if root.is-video-mode: Rectangle {
                        width: 52px;
                        height: 28px;
                        background: root.is-playing ? #ff5f56 : #4a4a5a;
                        border-radius: 4px;
                        Text {
                            text: root.is-playing ? "⏸" : "▶";
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 700;
                        }
                        TouchArea {
                            clicked => { root.toggle-playback(); }
                        }
                    }

                    if root.is-video-mode: Rectangle {
                        width: 60px;
                        height: 28px;
                        background: #4a4a5a;
                        border-radius: 4px;
                        Text {
                            text: @tr("Cut {}", root.cut-count);
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 12px;
                        }
                        TouchArea {
                            clicked => { root.add-cut(); }
                        }
                    }

                    if root.is-video-mode: Rectangle {
                        width: 72px;
                        height: 28px;
                        background: #4a4a5a;
                        border-radius: 4px;
                        Text {
                            text: @tr("Zoom {}", root.zoom-count);
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 12px;
                        }
                        TouchArea {
                            clicked => { root.add-zoom(); }
                        }
                    }

                    if root.is-video-mode: Rectangle {
                        width: 84px;
                        height: 28px;
                        background: #4a4a5a;
                        border-radius: 4px;
                        Text {
                            text: @tr("Censor {}", root.censor-count);
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 12px;
                        }
                        TouchArea {
                            clicked => { root.add-censor(); }
                        }
                    }

                    // --- Record / Stop button ---
                    if !root.is-video-mode: Rectangle {
                        width: 80px;
                        height: 28px;
                        background: root.is-recording ? #ff5f56 : #e63946;
                        border-radius: 4px;
                        Text {
                            text: root.is-recording ? "■ Stop" : "● Record";
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 600;
                            font-size: 12px;
                        }
                        TouchArea {
                            enabled: !root.busy;
                            clicked => { root.toggle-record(); }
                        }
                    }

                    // --- Divider ---
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: #3a3a48;
                    }

                    Rectangle {
                        width: 70px;
                        height: 28px;
                        background: root.busy ? #005ab5 : #0084ff;
                        border-radius: 4px;
                        Text {
                            text: "Copy";
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 600;
                        }
                        TouchArea {
                            enabled: !root.busy;
                            clicked => { root.copy-to-clipboard(); }
                        }
                    }

                    Rectangle {
                        width: 70px;
                        height: 28px;
                        background: root.busy ? #2b6b38 : #39b54a;
                        border-radius: 4px;
                        Text {
                            text: root.is-video-mode ? "Export" : "Save";
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 600;
                        }
                        TouchArea {
                            enabled: !root.busy;
                            clicked => { root.save-image(); }
                        }
                    }

                    // --- Exit Video button ---
                    if root.is-video-mode: Rectangle {
                        width: 90px;
                        height: 28px;
                        background: #4a4a5a;
                        border-radius: 4px;
                        Text {
                            text: "Exit video";
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 12px;
                        }
                        TouchArea {
                            clicked => { root.exit-video(); }
                        }
                    }
                }
            }

            // ═══════════ Center content: Viewport + optional OCR panel ═══════════
            HorizontalLayout {
                // Canvas viewport
                Rectangle {
                    background: #111114;
                    clip: true;

                    Flickable {
                        content-width: root.image-width * root.zoom-level;
                        content-height: root.image-height * root.zoom-level;

                        Image {
                            source: root.canvas-image;
                            width: root.image-width * root.zoom-level;
                            height: root.image-height * root.zoom-level;
                            image-rendering: root.zoom-level >= 2.0 ? pixelated : smooth;
                        }

                        // Video-mode click: set focus point for zoom/censor placement
                        if root.is-video-mode: TouchArea {
                            width: root.image-width * root.zoom-level;
                            height: root.image-height * root.zoom-level;
                            clicked => {
                                root.video-clicked(
                                    self.mouse-x / 1px / root.zoom-level,
                                    self.mouse-y / 1px / root.zoom-level
                                );
                            }
                        }
                    }
                }

                // OCR panel (right side)
                if root.ocr-panel-visible: Rectangle {
                    width: 320px;
                    background: #1e1e26;
                    border-width: 1px;
                    border-color: #32323e;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            height: 28px;
                            spacing: 8px;

                            Text {
                                text: "OCR Text";
                                color: #ccccdd;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Rectangle { /* Spacer */ }

                            Rectangle {
                                width: 90px;
                                height: 26px;
                                background: #0084ff;
                                border-radius: 4px;
                                Text {
                                    text: "Copy text";
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                }
                                TouchArea {
                                    clicked => { root.copy-ocr-text(); }
                                }
                            }
                        }

                        Rectangle {
                            background: #141418;
                            border-radius: 6px;

                            Flickable {
                                content-width: self.width;

                                Text {
                                    text: root.ocr-text;
                                    color: #ddddee;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                    width: parent.width - 16px;
                                    x: 8px;
                                    y: 8px;
                                }
                            }
                        }
                    }
                }
            }

            // ═══════════ Status bar ═══════════
            Rectangle {
                height: 24px;
                background: #1a1a22;
                border-width: 1px;
                border-color: #2a2a36;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;

                    Text {
                        text: root.status-text;
                        color: #888899;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }

            // ═══════════ Bottom timeline for video mode ═══════════
            if root.is-video-mode: VideoTimelineView {
                height: 120px;
                current-time: root.current-time;
                total-duration: root.total-duration;
                is-playing: root.is-playing;
                cut-count: root.cut-count;
                zoom-count: root.zoom-count;
                censor-count: root.censor-count;
                toggle-playback => { root.toggle-playback(); }
                seek(t) => { root.seek(t); }
                add-cut => { root.add-cut(); }
                add-zoom => { root.add-zoom(); }
                add-censor => { root.add-censor(); }
            }
        }
    }
}
